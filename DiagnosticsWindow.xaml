<Window x:Class="Tumbler.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика" Width="600" Height="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <Grid Margin="20,18,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" FontSize="17" FontWeight="SemiBold" Text="Проверяю…" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Checks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14,12" Margin="0,0,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="15"
                                           Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0,3,0,0"/>
                                    <Grid Margin="0,8,0,0" Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12" TextWrapping="Wrap"/>
                                        <Button Grid.Column="1" Content="Копировать" Tag="{Binding Command}" Click="Copy_Click"
                                                Margin="8,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Warning">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Fail">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_Click" MinWidth="92" Margin="8,0,0,0"/>
            <Button x:Name="RepairButton" DockPanel.Dock="Left" Content="Установить недостающее" Style="{StaticResource AccentButton}"
                    Click="Repair_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="RunButton" DockPanel.Dock="Left" Content="Проверить снова" Click="Run_Click"/>
            <Button DockPanel.Dock="Left" Content="Скопировать отчёт" Click="CopyReport_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="Лог службы" Click="Log_Click" Margin="8,0,0,0" HorizontalAlignment="Left"/>
        </DockPanel>
    </Grid>
</Window>
