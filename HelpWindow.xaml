<Window x:Class="Tumbler.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Width="780" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TopicItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="8" Padding="12,9" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,16,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Разделы -->
        <ListBox x:Name="Topics" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,0"
                 ItemContainerStyle="{StaticResource TopicItem}" SelectionChanged="Topics_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="запущен" Foreground="{StaticResource Accent}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,1,0,0"
                                   Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Содержимое раздела -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="4,2,14,8">
                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>

                <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0"
                        Visibility="{Binding HasPort, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="КАКОЙ ПОРТ УКАЗАТЬ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Port}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ЧТО СДЕЛАТЬ" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"
                           Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Line}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14,11" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Problem}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Fix}" Style="{StaticResource Note}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="ПОЛЕЗНО ЗНАТЬ" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"
                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{StaticResource Faint}"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Note}" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Найденные прокси: порт можно выбрать прямо отсюда -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" MinWidth="92" Margin="12,0,0,0"
                        VerticalAlignment="Bottom" Click="Close_Click"/>
                <StackPanel>
                    <TextBlock x:Name="FoundText" Style="{StaticResource Note}"/>
                    <ItemsControl x:Name="Found" Margin="0,7,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Chip}" Content="{Binding Label}" Tag="{Binding Port}" ToolTip="{Binding Hint}"
                                        Click="Port_Click" Margin="0,0,6,4" FontSize="12.5" Padding="10,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
