<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:Tumbler.Gui"
        x:Class="Tumbler.Gui.DiagnosticsWindow"
        Title="Диагностика" Width="620" Height="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,18,20,14" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="Summary" Classes="headline" Text="Проверяю…" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Checks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="gui:CheckResult">
                        <Border Classes="card" Margin="0,0,10,8">
                            <Grid ColumnDefinitions="28,*">
                                <Panel Margin="0,2,0,0" VerticalAlignment="Top">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="15" Height="15" Foreground="{StaticResource Accent}" IsVisible="{Binding IsOk}"/>
                                    <PathIcon Data="{StaticResource IconAlert}" Width="15" Height="15" Foreground="{StaticResource Warn}" IsVisible="{Binding IsWarning}"/>
                                    <PathIcon Data="{StaticResource IconClose}" Width="15" Height="15" Foreground="{StaticResource Danger}" IsVisible="{Binding IsFail}"/>
                                </Panel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Classes="note" Margin="0,3,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding HasCommand}">
                                        <SelectableTextBlock Text="{Binding Command}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Копировать" Tag="{Binding Command}" Click="Copy_Click" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Закрыть" MinWidth="92" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" Content="Проверить снова" Click="Run_Click"/>
                <Button Content="Скопировать отчёт" Click="CopyReport_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
