<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:Tumbler.Gui"
        xmlns:tumbler="using:Tumbler"
        x:Class="Tumbler.Gui.HelpWindow"
        Title="Справка" Width="800" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16,16,16,14" ColumnDefinitions="210,*" RowDefinitions="*,Auto">
        <ListBox x:Name="Topics" Background="Transparent" Margin="0,0,12,0" SelectionChanged="Topics_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="gui:HelpTopic">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="запущен" Foreground="{StaticResource Accent}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,1,0,0" IsVisible="{Binding Running}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="4,2,14,8" x:DataType="gui:HelpTopic">
                <TextBlock Text="{Binding Title}" Classes="headline"/>
                <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding HasPort}">
                    <StackPanel>
                        <TextBlock Text="КАКОЙ ПОРТ УКАЗАТЬ" Classes="section" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Port}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ЧТО СДЕЛАТЬ" Classes="section" Margin="0,20,0,10" IsVisible="{Binding HasSteps}"/>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="gui:HelpStep">
                            <Grid ColumnDefinitions="34,*" Margin="0,0,0,10">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Line}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="gui:HelpQuestion">
                            <Border Classes="card" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Problem}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Fix}" Classes="note" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="ПОЛЕЗНО ЗНАТЬ" Classes="section" Margin="0,12,0,8" IsVisible="{Binding HasNotes}"/>
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="16,*" Margin="0,0,0,7">
                                <TextBlock Text="•" Classes="faint"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Classes="note" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Найденные прокси: порт можно выбрать прямо отсюда -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" MinWidth="92" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="Close_Click"/>
                <StackPanel>
                    <TextBlock x:Name="FoundText" Classes="note"/>
                    <ItemsControl x:Name="Found" Margin="0,7,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tumbler:PortPreset">
                                <Button Classes="chip" Tag="{Binding Port}" ToolTip.Tip="{Binding Hint}"
                                        Click="Port_Click" Margin="0,0,6,4" FontSize="12.5" Padding="10,5">
                                    <TextBlock Text="{Binding Label}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
